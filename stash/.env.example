# Copy to .env.local for local dev. Real values live only in Vercel env.
# Never commit .env.local.

# Supabase (public: URL + anon/publishable key only). These two are everything the app needs.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon or publishable key>

# Nothing else goes here. AI keys, the worker token, the cron secret, the app URL and the Web Push
# keys live in Supabase Vault (see README -> "Setup" and "Reminders"); the website never sees them.
