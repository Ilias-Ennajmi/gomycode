# Copy to .env.local for local dev. Real values live only in Vercel env (marked sensitive).
# Never commit .env.local.

# Supabase (public: URL + anon/publishable key only)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon or publishable key>


# Phase 1 (server-only, optional): VOYAGE_API_KEY turns on search by meaning in /api/search.
# Videos are signed from Supabase Storage with the user's own session, so nothing else is needed here.
# The worker's settings live in GitHub (see worker/README.md).
# VOYAGE_API_KEY=
# VOYAGE_MODEL=voyage-4-lite
