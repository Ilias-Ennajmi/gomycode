# Copy to .env.local for local dev. Real values live only in Vercel env (marked sensitive).
# Never commit .env.local.

# Supabase (public: URL + anon/publishable key only)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon or publishable key>


# Phase 1 (server-only). Vercel needs R2_* (video links) and VOYAGE_API_KEY (search by meaning);
# the worker needs the rest (see worker/README.md).
# SUPABASE_SERVICE_ROLE_KEY=
# CLAUDE_FAST_MODEL=
# CLAUDE_SMART_MODEL=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# VOYAGE_API_KEY=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# WORKER_URL=
# WORKER_SECRET=
