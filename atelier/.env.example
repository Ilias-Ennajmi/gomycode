# Copy to .env.local and fill in. Never commit real values.

# Supabase (existing project, schema "atelier")
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The one Supabase user id allowed to open Atelier
ATELIER_OWNER_ID=

# Set to 1 for dev/e2e only: no login, no sync. Refused when VERCEL_ENV=production.
ATELIER_LOCAL_ONLY=

# Cloudflare R2 (image storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_HOST=
