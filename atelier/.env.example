# Copy to .env.local and fill in. Never commit real values.

# Supabase (existing project, schema "atelier")
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The one Supabase user id allowed to open Atelier
ATELIER_OWNER_ID=

# Set to 1 for dev/e2e only: no login, no sync. Refused when VERCEL_ENV=production.
ATELIER_LOCAL_ONLY=

# Cloudflare R2 (image storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_HOST=

# The same public host, readable by the browser (it builds image URLs). Set both to the same value.
NEXT_PUBLIC_R2_PUBLIC_HOST=

# Share links (Phase 3): signs the cookie a client gets after opening a review link. At least 32 random characters
# (openssl rand -base64 48). To rotate, put the new value FIRST and keep the old one after a comma for 12 hours, then drop it.
SHARE_COOKIE_SECRET=
