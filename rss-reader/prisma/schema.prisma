generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Supabase: DATABASE_URL is the transaction pooler, DIRECT_URL the session
  // pooler used for migrations. Locally both can point at the same database.
  directUrl = env("DIRECT_URL")
}

model Category {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#6366f1")
  icon      String?
  order     Int      @default(0)
  feeds     Feed[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum FeedType {
  rss
  youtube
  newsletter
}

model Feed {
  id          String    @id @default(cuid())
  type        FeedType  @default(rss)
  title       String
  url         String    @unique
  siteUrl     String?
  description String?
  faviconUrl  String?
  coverUrl    String?
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  articles    Article[]
  lastFetched DateTime?
  errorCount  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([categoryId])
}

model Article {
  id          String    @id @default(cuid())
  feedId      String
  feed        Feed      @relation(fields: [feedId], references: [id], onDelete: Cascade)
  title       String
  link        String
  summary     String?
  content     String?
  imageUrl    String?
  author      String?
  publishedAt DateTime
  isRead      Boolean   @default(false)
  isSaved     Boolean   @default(false)
  isVideo     Boolean   @default(false)
  readAt      DateTime?
  savedAt     DateTime?
  createdAt   DateTime  @default(now())

  @@unique([feedId, link])
  @@index([feedId])
  @@index([isRead])
  @@index([isSaved])
  @@index([publishedAt])
}

enum FilterAction {
  hide
  boost
}

enum FilterMatch {
  keyword
  feed
}

model FilterRule {
  id        String       @id @default(cuid())
  action    FilterAction
  match     FilterMatch
  // The keyword text, or the feed id when match = feed.
  value     String
  createdAt DateTime     @default(now())

  @@unique([action, match, value])
}

model Setting {
  key   String @id
  value String
}
