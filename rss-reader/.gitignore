# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# The repo-root .gitignore is a Python template that ignores every `lib/`
# directory; this app's source lives in lib/, so re-include it.
!lib/

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# prisma
/prisma/dev.db
/prisma/dev.db-journal

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
