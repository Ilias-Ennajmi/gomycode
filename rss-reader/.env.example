# Postgres. On Supabase, DATABASE_URL is the transaction pooler (port 6543,
# ?pgbouncer=true&connection_limit=1) and DIRECT_URL the session pooler (5432).
DATABASE_URL="postgresql://rss:rss@localhost:5432/rss_reader"
DIRECT_URL="postgresql://rss:rss@localhost:5432/rss_reader"

CRON_SECRET="your-secret-here"       # Protects /api/refresh when called by cron
APP_PASSWORD="choose-a-password"     # Single-user login gate
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: free Google Gemini key (aistudio.google.com) for summaries, story
# grouping, the daily briefing, and promo filtering. The app works without it.
GEMINI_API_KEY=""
# Optional: timezone that decides when a new daily briefing starts.
APP_TIMEZONE="Europe/Paris"

# Optional: Web Push notifications (morning briefing, breaking news). Generate a pair with
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="https://your-app.example"
